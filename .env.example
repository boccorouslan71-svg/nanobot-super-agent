# nanobot super-agent — environment variables
#
# Copy to `.env` locally, or set these as environment variables in your
# deployment (Render dashboard → Environment). The committed runtime config
# (render-config.json) references them as ${VAR} placeholders and resolves
# them at startup, so no secret is ever stored in this repository.
#
# Any placeholder whose variable is unset is left as-is and the feature simply
# stays inactive, so you can start with a subset and add the rest later.

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------

# Agnès AI — primary model provider (OpenAI-compatible API hub).
# Used by agents.defaults: model `agnes-2.5-flash`, provider `agnes`.
AGNES_API_KEY=
# Override only if Agnès changes its endpoint; the default is already wired.
# AGNES_API_BASE=https://apihub.agnes-ai.com/v1

# Google Gemini — automatic fallback when Agnès is unavailable, rate-limited,
# or returns an error. Chain: agnes-2.5-flash → gemini-2.5-flash → gemini-2.5-pro.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic — optional third provider, kept available for manual model switching.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Composio — third-party tool catalogue (~1200 tools: Gmail, Slack, Notion,
# GitHub, Linear, Google Calendar, social networks, …)
# ---------------------------------------------------------------------------

# API key from https://app.composio.dev — enables the five bridge tools
# (catalogue search, tool schema, execution, OAuth connect, connection health).
# Without it the bridge tools hide themselves and nothing else is affected.
COMPOSIO_API_KEY=

# Identity that owns the Composio connected accounts. Keep it stable: OAuth
# connections are stored per user id, so changing this hides existing grants.
COMPOSIO_USER_ID=nanobot-owner

# ---------------------------------------------------------------------------
# Telegram channel
# ---------------------------------------------------------------------------

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user id allowed to command the bot. This is an exact-match
# allowlist: every other sender receives a pairing code instead of access.
# Find your id by messaging @userinfobot.
TELEGRAM_OWNER_ID=

# ---------------------------------------------------------------------------
# WebUI / gateway
# ---------------------------------------------------------------------------

# Shared secret gating the bundled WebUI. Generate with `openssl rand -hex 32`.
NANOBOT_WEB_TOKEN=

# Port the platform routes public traffic to (matches channels.websocket.port).
PORT=8765

# ---------------------------------------------------------------------------
# Supabase — durable state on hosts without a persistent disk
# ---------------------------------------------------------------------------
#
# Free container hosts recreate the filesystem on every deploy and after every
# sleep cycle, which would drop the cron store. When these two variables are
# set, nanobot mirrors `cron/jobs.json` into Supabase: it restores the file at
# startup (before the cron service reads it) and snapshots changes while it
# runs. Leave them empty to run without the mirror — the mirror simply stays
# inactive, nothing else changes.
#
# Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
SUPABASE_URL=

# Service / secret key (NOT the publishable key): the mirror table has RLS
# enabled, so only this key can read or write it. Keep it out of the repository
# and set it in the deployment environment only.
# Supabase dashboard → Project Settings → API keys.
SUPABASE_SERVICE_KEY=

# Expected schema (created once per project, in the public schema):
#   create table public.nanobot_state_blobs (
#     key text primary key,
#     content jsonb not null,
#     content_hash text not null,
#     updated_at timestamptz not null default now()
#   );
#   alter table public.nanobot_state_blobs enable row level security;
