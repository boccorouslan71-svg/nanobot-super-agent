{
  "agents": {
    "defaults": {
      "model": "agnes-2.5-flash",
      "provider": "agnes",
      "maxTokens": 16384,
      "contextWindowTokens": 200000,
      "fallbackModels": [
        {
          "model": "gemini-2.5-flash",
          "provider": "gemini",
          "maxTokens": 16384
        },
        {
          "model": "gemini-2.5-pro",
          "provider": "gemini",
          "maxTokens": 16384
        }
      ],
      "timezone": "Africa/Porto-Novo",
      "timezoneMode": "manual",
      "botName": "nanobot",
      "unifiedSession": true
    }
  },
  "providers": {
    "agnes": {
      "apiKey": "${AGNES_API_KEY}",
      "apiBase": "https://apihub.agnes-ai.com/v1"
    },
    "gemini": {
      "apiKey": "${GEMINI_API_KEY}"
    },
    "anthropic": {
      "apiKey": "${ANTHROPIC_API_KEY}"
    }
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "mode": "polling",
      "allowFrom": [
        "${TELEGRAM_OWNER_ID}"
      ],
      "groupPolicy": "mention",
      "streaming": true,
      "replyToMessage": true
    },
    "websocket": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8765,
      "tokenIssueSecret": "${NANOBOT_WEB_TOKEN}",
      "websocketRequiresToken": true
    }
  },
  "tools": {
    "restrictToWorkspace": true,
    "webuiAllowRemotePackageInstall": false,
    "my": {
      "allowSet": false
    },
    "composio": {
      "apiKey": "${COMPOSIO_API_KEY}",
      "userId": "${COMPOSIO_USER_ID}"
    }
  }
}
